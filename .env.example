# Server only. Never prefix these secrets with VITE_.
# Generate a random verification token and enter the same value in Meta.
WHATSAPP_VERIFY_TOKEN=
# App Dashboard > App settings > Basic > App secret (not an access token).
META_APP_SECRET=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=3001
WEBHOOK_DB_PATH=.runtime/whatsapp.sqlite

# Initial owner credentials, generated by scripts/bootstrap-account.mjs.
# These are local bootstrap values, never deployed as Worker secrets.
KLIVO_ADMIN_EMAIL=scrowlly.contact@gmail.com
KLIVO_ADMIN_USERNAME=
KLIVO_ADMIN_PASSWORD=
# Meta token stays on the server. Do not use a VITE_ prefix.
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Only this verified test recipient can receive sends from the panel (digits).
WHATSAPP_TEST_RECIPIENT=
